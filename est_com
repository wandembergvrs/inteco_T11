<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Estática Comparativa — Demanda e Oferta</title>
  <style>
    :root{
      --bg:#0f172a;
      --panel:#111827;
      --panel-2:#0b1220;
      --text:#e5e7eb;
      --muted:#94a3b8;
      --grid:#1f2937;
      --axis:#9ca3af;
      --blue:#60a5fa;
      --blue-soft:rgba(96,165,250,.18);
      --green:#4ade80;
      --green-soft:rgba(74,222,128,.18);
      --orange:#f59e0b;
      --purple:#c084fc;
      --red:#f87171;
      --yellow:#fde68a;
      --border:#233043;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,"Helvetica Neue",Arial,sans-serif;
      background:var(--bg);
      color:var(--text);
      min-height:100vh;
    }
    .wrap{
      max-width:1400px;
      margin:0 auto;
      padding:20px;
    }
    header{
      margin-bottom:16px;
    }
    h1{
      margin:0 0 6px 0;
      font-size:30px;
      line-height:1.1;
    }
    .sub{
      color:var(--muted);
      font-size:14px;
      line-height:1.45;
      max-width:980px;
    }

    .layout{
      display:grid;
      grid-template-columns:370px 1fr;
      gap:16px;
      align-items:start;
    }
    .panel{
      background:var(--panel);
      border:1px solid var(--border);
      border-radius:18px;
      padding:16px;
      box-shadow:0 8px 30px rgba(0,0,0,.18);
    }
    .panel h2{
      margin:0 0 10px 0;
      font-size:18px;
    }
    .modeButtons{
      display:grid;
      grid-template-columns:1fr;
      gap:8px;
      margin-bottom:14px;
    }
    button{
      border:1px solid var(--border);
      background:var(--panel-2);
      color:var(--text);
      border-radius:12px;
      padding:10px 12px;
      font-weight:700;
      cursor:pointer;
      transition:.15s ease;
    }
    button:hover{border-color:#3b4f69;transform:translateY(-1px)}
    button.active{
      border-color:#4f78aa;
      background:#122033;
      box-shadow:inset 0 0 0 1px rgba(96,165,250,.35);
    }
    .presetGrid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
      margin-top:10px;
    }

    .row{
      margin-top:12px;
    }
    label{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      font-size:13px;
      color:var(--muted);
      margin-bottom:5px;
    }
    input[type="range"]{
      width:100%;
      accent-color:#60a5fa;
    }
    .value{
      color:var(--text);
      font-variant-numeric:tabular-nums;
      font-weight:700;
    }

    .metrics{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
      margin-top:14px;
    }
    .metric{
      background:var(--panel-2);
      border:1px solid var(--border);
      border-radius:14px;
      padding:12px;
    }
    .metric .k{
      font-size:12px;
      color:var(--muted);
      margin-bottom:4px;
    }
    .metric .v{
      font-size:22px;
      font-weight:800;
      font-variant-numeric:tabular-nums;
    }
    .explain{
      margin-top:14px;
      background:var(--panel-2);
      border:1px solid var(--border);
      border-radius:14px;
      padding:14px;
      line-height:1.45;
      font-size:14px;
    }
    .legend{
      display:flex;
      gap:14px;
      flex-wrap:wrap;
      margin-top:10px;
      color:#cbd5e1;
      font-size:12px;
    }
    .dot{
      width:11px;height:11px;border-radius:50%;display:inline-block;margin-right:6px;vertical-align:middle;
    }

    .canvasPanel{
      padding:12px;
    }
    canvas{
      width:100%;
      height:auto;
      display:block;
      background:var(--panel-2);
      border-radius:16px;
    }
    .notes{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:10px;
      margin-top:10px;
    }
    .note{
      background:var(--panel-2);
      border:1px solid var(--border);
      border-radius:14px;
      padding:12px;
      font-size:13px;
      line-height:1.4;
      color:#dbe4f3;
    }
    .note strong{display:block;margin-bottom:4px;color:#fff}

    @media (max-width: 1020px){
      .layout{grid-template-columns:1fr}
      .notes{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>Estática Comparativa</h1>
      <div class="sub">
        Material interativo para mostrar três ideias centrais: <strong>aumento do preço</strong>, <strong>deslocamentos ao longo da curva</strong> e <strong>deslocamentos da curva</strong>. A lógica foi simplificada a partir da modelagem anexa, mas agora focada apenas no aprendizado desses movimentos.
      </div>
    </header>

    <div class="layout">
      <section class="panel">
        <h2>Escolha o conceito</h2>
        <div class="modeButtons">
          <button id="modePrice" class="active">1. Aumento de preço e movimento ao longo da curva</button>
          <button id="modeDemand">2. Deslocamento da curva de demanda</button>
          <button id="modeSupply">3. Deslocamento da curva de oferta</button>
        </div>

        <div class="row">
          <label for="priceSlider">
            <span>Preço observado</span>
            <span class="value" id="priceValue">5,5</span>
          </label>
          <input id="priceSlider" type="range" min="1" max="10" step="0.1" value="5.5" />
        </div>

        <div class="row">
          <label for="demandShiftSlider">
            <span>Deslocamento da demanda</span>
            <span class="value" id="demandShiftValue">0,0</span>
          </label>
          <input id="demandShiftSlider" type="range" min="-3" max="3" step="0.1" value="0" />
        </div>

        <div class="row">
          <label for="supplyShiftSlider">
            <span>Deslocamento da oferta</span>
            <span class="value" id="supplyShiftValue">0,0</span>
          </label>
          <input id="supplyShiftSlider" type="range" min="-3" max="3" step="0.1" value="0" />
        </div>

        <div class="presetGrid">
          <button id="btnPriceUp">Preço ↑</button>
          <button id="btnPriceDown">Preço ↓</button>
          <button id="btnDemandUp">Demanda →</button>
          <button id="btnDemandDown">Demanda ←</button>
          <button id="btnSupplyUp">Oferta →</button>
          <button id="btnSupplyDown">Oferta ←</button>
        </div>

        <div class="presetGrid" style="margin-top:8px;grid-template-columns:1fr;">
          <button id="btnReset">Resetar</button>
        </div>

        <div class="metrics">
          <div class="metric">
            <div class="k">Qd no preço observado</div>
            <div class="v" id="qdMetric">—</div>
          </div>
          <div class="metric">
            <div class="k">Qs no preço observado</div>
            <div class="v" id="qsMetric">—</div>
          </div>
          <div class="metric">
            <div class="k">Equilíbrio inicial</div>
            <div class="v" id="eq0Metric">—</div>
          </div>
          <div class="metric">
            <div class="k">Equilíbrio atual</div>
            <div class="v" id="eq1Metric">—</div>
          </div>
        </div>

        <div class="explain" id="explainBox"></div>

        <div class="legend">
          <span><span class="dot" style="background:var(--blue)"></span>Demanda atual</span>
          <span><span class="dot" style="background:var(--green)"></span>Oferta atual</span>
          <span><span class="dot" style="background:var(--orange)"></span>Preço observado</span>
          <span><span class="dot" style="background:var(--yellow)"></span>Equilíbrio</span>
          <span><span class="dot" style="background:var(--purple)"></span>Setas de comparação</span>
        </div>
      </section>

      <section class="panel canvasPanel">
        <canvas id="chart" width="1100" height="700"></canvas>
        <div class="notes">
          <div class="note">
            <strong>Movimento ao longo da curva</strong>
            Acontece quando <em>o preço muda</em> e os demais fatores permanecem constantes. O ponto se move <em>sobre</em> a mesma curva.
          </div>
          <div class="note">
            <strong>Deslocamento da curva</strong>
            Acontece quando muda um fator <em>além do preço</em>, como renda, preferências, tecnologia ou número de vendedores.
          </div>
          <div class="note">
            <strong>Leitura pedagógica</strong>
            Para ensinar, compare sempre o desenho inicial e o desenho novo: mesma curva = movimento ao longo; curva nova = deslocamento.
          </div>
        </div>
      </section>
    </div>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);

    const canvas = $('chart');
    const ctx = canvas.getContext('2d');

    const priceSlider = $('priceSlider');
    const demandShiftSlider = $('demandShiftSlider');
    const supplyShiftSlider = $('supplyShiftSlider');

    const priceValue = $('priceValue');
    const demandShiftValue = $('demandShiftValue');
    const supplyShiftValue = $('supplyShiftValue');

    const qdMetric = $('qdMetric');
    const qsMetric = $('qsMetric');
    const eq0Metric = $('eq0Metric');
    const eq1Metric = $('eq1Metric');
    const explainBox = $('explainBox');

    const modeButtons = {
      price: $('modePrice'),
      demand: $('modeDemand'),
      supply: $('modeSupply')
    };

    const base = {
      a: 10.0,
      b: 1.0,
      c: 1.0,
      d: 0.8,
      price: 5.5,
      demandShift: 0,
      supplyShift: 0
    };

    let state = {
      mode: 'price',
      price: base.price,
      demandShift: 0,
      supplyShift: 0
    };

    const pad = { left: 80, right: 40, top: 40, bottom: 70 };
    let QMAX = 12;
    let PMAX = 12;

    const fmt = (n, d=1) => Number(n).toLocaleString('pt-BR', { minimumFractionDigits: d, maximumFractionDigits: d });
    const clamp = (x, a, b) => Math.max(a, Math.min(b, x));

    function eq(a, b, c, d){
      const Q = (a - c) / (b + d);
      const P = a - b * Q;
      return { Q, P };
    }

    function qDemand(price, a, b){
      return Math.max(0, (a - price) / b);
    }

    function qSupply(price, c, d){
      return Math.max(0, (price - c) / d);
    }

    function setupByMode(){
      if(state.mode === 'price'){
        demandShiftSlider.disabled = true;
        supplyShiftSlider.disabled = true;
        priceSlider.disabled = false;
        state.demandShift = 0;
        state.supplyShift = 0;
        demandShiftSlider.value = 0;
        supplyShiftSlider.value = 0;
      }
      if(state.mode === 'demand'){
        demandShiftSlider.disabled = false;
        supplyShiftSlider.disabled = true;
        priceSlider.disabled = true;
        state.price = base.price;
        state.supplyShift = 0;
        priceSlider.value = base.price;
        supplyShiftSlider.value = 0;
      }
      if(state.mode === 'supply'){
        demandShiftSlider.disabled = true;
        supplyShiftSlider.disabled = false;
        priceSlider.disabled = true;
        state.price = base.price;
        state.demandShift = 0;
        priceSlider.value = base.price;
        demandShiftSlider.value = 0;
      }

      Object.entries(modeButtons).forEach(([key, btn]) => {
        btn.classList.toggle('active', key === state.mode);
      });

      syncValues();
      draw();
    }

    function syncValues(){
      priceValue.textContent = fmt(state.price,1);
      demandShiftValue.textContent = fmt(state.demandShift,1);
      supplyShiftValue.textContent = fmt(state.supplyShift,1);
    }

    function toPx(q, p){
      const W = canvas.width - pad.left - pad.right;
      const H = canvas.height - pad.top - pad.bottom;
      return [
        pad.left + (q / QMAX) * W,
        pad.top + H - (p / PMAX) * H
      ];
    }

    function line(q1,p1,q2,p2,color,width=2,dash=[]){
      const [x1,y1]=toPx(q1,p1);
      const [x2,y2]=toPx(q2,p2);
      ctx.save();
      ctx.beginPath();
      ctx.setLineDash(dash);
      ctx.moveTo(x1,y1);
      ctx.lineTo(x2,y2);
      ctx.lineWidth=width;
      ctx.strokeStyle=color;
      ctx.stroke();
      ctx.restore();
    }

    function circle(q,p,r,color,stroke='#0f172a'){
      const [x,y]=toPx(q,p);
      ctx.beginPath();
      ctx.arc(x,y,r,0,2*Math.PI);
      ctx.fillStyle=color;
      ctx.fill();
      ctx.lineWidth=1.5;
      ctx.strokeStyle=stroke;
      ctx.stroke();
    }

    function textAt(q,p,text,color='#e5e7eb',dx=8,dy=-8,align='left'){
      const [x,y]=toPx(q,p);
      ctx.save();
      ctx.fillStyle=color;
      ctx.font='13px ui-sans-serif';
      ctx.textAlign=align;
      ctx.fillText(text, x+dx, y+dy);
      ctx.restore();
    }

    function arrow(q1,p1,q2,p2,color){
      const [x1,y1]=toPx(q1,p1);
      const [x2,y2]=toPx(q2,p2);
      const angle = Math.atan2(y2-y1, x2-x1);
      const len = 10;
      ctx.save();
      ctx.strokeStyle=color;
      ctx.fillStyle=color;
      ctx.lineWidth=2.4;
      ctx.beginPath();
      ctx.moveTo(x1,y1);
      ctx.lineTo(x2,y2);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x2,y2);
      ctx.lineTo(x2 - len*Math.cos(angle - Math.PI/6), y2 - len*Math.sin(angle - Math.PI/6));
      ctx.lineTo(x2 - len*Math.cos(angle + Math.PI/6), y2 - len*Math.sin(angle + Math.PI/6));
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    }

    function drawAxes(){
      ctx.clearRect(0,0,canvas.width,canvas.height);

      for(let x=0; x<=QMAX; x+=1){
        line(x,0,x,PMAX,'#1f2937',1);
      }
      for(let y=0; y<=PMAX; y+=1){
        line(0,y,QMAX,y,'#1f2937',1);
      }

      line(0,0,QMAX,0,'#9ca3af',2.5);
      line(0,0,0,PMAX,'#9ca3af',2.5);

      ctx.save();
      ctx.fillStyle='#cbd5e1';
      ctx.font='12px ui-sans-serif';
      ctx.textAlign='center';
      for(let x=0; x<=QMAX; x+=1){
        const [px,py]=toPx(x,0);
        ctx.fillText(String(x), px, py+18);
      }
      ctx.textAlign='right';
      for(let y=0; y<=PMAX; y+=1){
        const [px,py]=toPx(0,y);
        ctx.fillText(String(y), px-8, py+4);
      }
      const W = canvas.width - pad.left - pad.right;
      const H = canvas.height - pad.top - pad.bottom;
      ctx.textAlign='center';
      ctx.fillText('Quantidade (Q)', pad.left + W/2, pad.top + H + 42);
      ctx.translate(22, pad.top + H/2);
      ctx.rotate(-Math.PI/2);
      ctx.fillText('Preço (P)', 0, 0);
      ctx.restore();
    }

    function drawCurve(intercept, slope, type, color, dash=[]){
      const q0 = 0;
      const p0 = intercept;
      const q1 = QMAX;
      const p1 = type === 'demand' ? intercept - slope*QMAX : intercept + slope*QMAX;
      line(q0,p0,q1,p1,color,3,dash);
    }

    function updateMetricsAndExplanation(model){
      qdMetric.textContent = fmt(model.qd,2);
      qsMetric.textContent = fmt(model.qs,2);
      eq0Metric.textContent = `(${fmt(model.eq0.Q,2)} ; ${fmt(model.eq0.P,2)})`;
      eq1Metric.textContent = `(${fmt(model.eq1.Q,2)} ; ${fmt(model.eq1.P,2)})`;

      let html = '';

      if(state.mode === 'price'){
        const dir = state.price > base.price ? 'aumentou' : state.price < base.price ? 'caiu' : 'permaneceu igual';
        html = `
          <strong>Leitura:</strong> o preço <strong>${dir}</strong>. Como as curvas não mudaram, houve apenas <strong>movimento ao longo das curvas</strong>.<br><br>
          Na <strong>demanda</strong>, preço maior reduz a quantidade demandada. Na <strong>oferta</strong>, preço maior aumenta a quantidade ofertada.<br><br>
          Em sala, este é o exemplo clássico para mostrar que <strong>variação no preço não desloca a curva</strong>; ela apenas muda o ponto escolhido sobre a própria curva.
        `;
      }

      if(state.mode === 'demand'){
        const dir = state.demandShift > 0 ? 'para a direita' : state.demandShift < 0 ? 'para a esquerda' : 'não se deslocou';
        const impactP = model.eq1.P > model.eq0.P ? 'aumenta' : model.eq1.P < model.eq0.P ? 'reduz' : 'mantém';
        const impactQ = model.eq1.Q > model.eq0.Q ? 'aumenta' : model.eq1.Q < model.eq0.Q ? 'reduz' : 'mantém';
        html = `
          <strong>Leitura:</strong> a curva de demanda se deslocou <strong>${dir}</strong>.<br><br>
          Isso representa mudança em algum fator <strong>diferente do preço</strong>, como renda, preferências ou número de compradores.<br><br>
          Neste desenho, o novo equilíbrio <strong>${impactP}</strong> o preço de equilíbrio e <strong>${impactQ}</strong> a quantidade de equilíbrio.
        `;
      }

      if(state.mode === 'supply'){
        const dir = state.supplyShift > 0 ? 'para a direita' : state.supplyShift < 0 ? 'para a esquerda' : 'não se deslocou';
        const impactP = model.eq1.P > model.eq0.P ? 'aumenta' : model.eq1.P < model.eq0.P ? 'reduz' : 'mantém';
        const impactQ = model.eq1.Q > model.eq0.Q ? 'aumenta' : model.eq1.Q < model.eq0.Q ? 'reduz' : 'mantém';
        html = `
          <strong>Leitura:</strong> a curva de oferta se deslocou <strong>${dir}</strong>.<br><br>
          Isso representa mudança em algum fator <strong>diferente do preço</strong>, como tecnologia, custos, produtividade ou número de vendedores.<br><br>
          Neste desenho, o novo equilíbrio <strong>${impactP}</strong> o preço de equilíbrio e <strong>${impactQ}</strong> a quantidade de equilíbrio.
        `;
      }

      explainBox.innerHTML = html;
    }

    function draw(){
      syncValues();

      const a0 = base.a;
      const b = base.b;
      const c0 = base.c;
      const d = base.d;

      const a1 = a0 + state.demandShift;     // demanda para a direita = intercepto maior
      const c1 = c0 - state.supplyShift;     // oferta para a direita = intercepto menor

      const eq0 = eq(a0,b,c0,d);
      const eq1 = eq(a1,b,c1,d);
      const qd = qDemand(state.price, a1, b);
      const qs = qSupply(state.price, c1, d);

      QMAX = Math.max(12, Math.ceil(Math.max(a0/b, a1/b, qd, qs, eq0.Q, eq1.Q) + 1));
      PMAX = Math.max(12, Math.ceil(Math.max(a0, a1, c0 + d*QMAX, c1 + d*QMAX, state.price, eq0.P, eq1.P) + 1));

      drawAxes();

      // curvas iniciais
      drawCurve(a0,b,'demand','rgba(148,163,184,.75)',[8,6]);
      drawCurve(c0,d,'supply','rgba(148,163,184,.75)',[8,6]);
      textAt(Math.max(1, eq0.Q-1.5), a0 - b*Math.max(1, eq0.Q-1.5), 'D0', '#cbd5e1');
      textAt(Math.max(1, eq0.Q+1.0), c0 + d*Math.max(1, eq0.Q+1.0), 'S0', '#cbd5e1');

      // curvas atuais
      drawCurve(a1,b,'demand','#60a5fa');
      drawCurve(c1,d,'supply','#4ade80');
      textAt(Math.max(0.8, eq1.Q-1.1), a1 - b*Math.max(0.8, eq1.Q-1.1), 'D1', '#60a5fa');
      textAt(Math.max(1.2, eq1.Q+0.8), c1 + d*Math.max(1.2, eq1.Q+0.8), 'S1', '#4ade80');

      // preço observado
      line(0, state.price, QMAX, state.price, '#f59e0b', 2.5, state.mode === 'price' ? [] : [10,6]);
      textAt(QMAX-1.5, state.price, `P = ${fmt(state.price,1)}`, '#f59e0b', 0, -10, 'right');

      // equilíbrios
      circle(eq0.Q, eq0.P, 5, '#cbd5e1');
      textAt(eq0.Q, eq0.P, 'E0', '#cbd5e1');
      circle(eq1.Q, eq1.P, 6, '#fde68a');
      textAt(eq1.Q, eq1.P, 'E1', '#fde68a');
      line(eq1.Q,0,eq1.Q,eq1.P,'rgba(253,230,138,.55)',1.4,[5,5]);
      line(0,eq1.P,eq1.Q,eq1.P,'rgba(253,230,138,.55)',1.4,[5,5]);

      // pontos para preço observado
      const qdBasePrice = qDemand(base.price, a0, b);
      const qsBasePrice = qSupply(base.price, c0, d);
      const qdCurrentPrice = qDemand(state.price, a1, b);
      const qsCurrentPrice = qSupply(state.price, c1, d);

      circle(qdCurrentPrice, state.price, 6, '#60a5fa');
      circle(qsCurrentPrice, state.price, 6, '#4ade80');
      textAt(qdCurrentPrice, state.price, 'Qd', '#60a5fa');
      textAt(qsCurrentPrice, state.price, 'Qs', '#4ade80');

      if(state.mode === 'price'){
        circle(qdBasePrice, base.price, 4, '#93c5fd', '#0f172a');
        circle(qsBasePrice, base.price, 4, '#86efac', '#0f172a');
        line(0, base.price, QMAX, base.price, 'rgba(245,158,11,.45)', 1.5, [5,5]);
        textAt(QMAX-1.8, base.price, `P0 = ${fmt(base.price,1)}`, 'rgba(245,158,11,.7)', 0, 14, 'right');
        arrow(qdBasePrice, base.price, qdCurrentPrice, state.price, '#c084fc');
        arrow(qsBasePrice, base.price, qsCurrentPrice, state.price, '#c084fc');
      }

      if(state.mode === 'demand'){
        const refP = base.price;
        const qOld = qDemand(refP, a0, b);
        const qNew = qDemand(refP, a1, b);
        arrow(qOld, refP, qNew, refP, '#c084fc');
        textAt((qOld+qNew)/2, refP, 'deslocamento da demanda', '#c084fc', 0, -14, 'center');
      }

      if(state.mode === 'supply'){
        const refP = base.price;
        const qOld = qSupply(refP, c0, d);
        const qNew = qSupply(refP, c1, d);
        arrow(qOld, refP, qNew, refP, '#c084fc');
        textAt((qOld+qNew)/2, refP, 'deslocamento da oferta', '#c084fc', 0, -14, 'center');
      }

      updateMetricsAndExplanation({ eq0, eq1, qd, qs });
    }

    // eventos
    priceSlider.addEventListener('input', (e)=>{
      state.price = parseFloat(e.target.value);
      draw();
    });
    demandShiftSlider.addEventListener('input', (e)=>{
      state.demandShift = parseFloat(e.target.value);
      draw();
    });
    supplyShiftSlider.addEventListener('input', (e)=>{
      state.supplyShift = parseFloat(e.target.value);
      draw();
    });

    modeButtons.price.addEventListener('click', ()=>{ state.mode='price'; setupByMode(); });
    modeButtons.demand.addEventListener('click', ()=>{ state.mode='demand'; setupByMode(); });
    modeButtons.supply.addEventListener('click', ()=>{ state.mode='supply'; setupByMode(); });

    $('btnPriceUp').addEventListener('click', ()=>{
      state.mode='price';
      state.price = clamp(state.price + 1, 1, 10);
      priceSlider.value = state.price;
      setupByMode();
    });
    $('btnPriceDown').addEventListener('click', ()=>{
      state.mode='price';
      state.price = clamp(state.price - 1, 1, 10);
      priceSlider.value = state.price;
      setupByMode();
    });
    $('btnDemandUp').addEventListener('click', ()=>{
      state.mode='demand';
      state.demandShift = clamp(state.demandShift + 1, -3, 3);
      demandShiftSlider.value = state.demandShift;
      setupByMode();
    });
    $('btnDemandDown').addEventListener('click', ()=>{
      state.mode='demand';
      state.demandShift = clamp(state.demandShift - 1, -3, 3);
      demandShiftSlider.value = state.demandShift;
      setupByMode();
    });
    $('btnSupplyUp').addEventListener('click', ()=>{
      state.mode='supply';
      state.supplyShift = clamp(state.supplyShift + 1, -3, 3);
      supplyShiftSlider.value = state.supplyShift;
      setupByMode();
    });
    $('btnSupplyDown').addEventListener('click', ()=>{
      state.mode='supply';
      state.supplyShift = clamp(state.supplyShift - 1, -3, 3);
      supplyShiftSlider.value = state.supplyShift;
      setupByMode();
    });
    $('btnReset').addEventListener('click', ()=>{
      state = { mode:'price', price:base.price, demandShift:0, supplyShift:0 };
      priceSlider.value = base.price;
      demandShiftSlider.value = 0;
      supplyShiftSlider.value = 0;
      setupByMode();
    });

    // responsivo sem distorção
    function resizeCanvas(){
      const rect = canvas.getBoundingClientRect();
      const scale = window.devicePixelRatio || 1;
      canvas.width = Math.max(820, Math.floor(rect.width * scale));
      canvas.height = Math.max(520, Math.floor(rect.width * 0.62 * scale));
      draw();
    }
    new ResizeObserver(resizeCanvas).observe(canvas);
    window.addEventListener('load', ()=> setupByMode());
  </script>
</body>
</html>
